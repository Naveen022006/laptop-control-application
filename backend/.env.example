# Backend Environment Configuration

# Database
DATABASE_URL=sqlite:///./laptop_control.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=60

# Device Configuration
DEVICE_REGISTRATION_ENABLED=true
MAX_COMMAND_QUEUE_SIZE=1000
COMMAND_TIMEOUT=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8100","http://127.0.0.1:3000","http://127.0.0.1:8100"]

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# For Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/laptop_control
