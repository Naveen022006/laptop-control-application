# Backend Configuration

## Environment Variables
ENV=development
DEBUG=true

## Database
DATABASE_URL=sqlite:///./laptop_control.db
SQL_ECHO=false

## Security
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256

## Server
HOST=0.0.0.0
PORT=8000

## Logging
LOG_LEVEL=INFO

## CORS
CORS_ORIGINS=*

## WebSocket
WS_HEARTBEAT_INTERVAL=30

## API
API_TITLE=Laptop Control API
API_VERSION=1.0.0
